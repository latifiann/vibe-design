# Build logs are reproducible output; QA records remain tracked.
/deliverables/**/*.build.log

# Keep the two active editable masters; other generated masters stay local.
/deliverables/**/*.pcraft
!/deliverables/v20/option-a/ravenxcope-a5-front-a-v20.pcraft
!/deliverables/v20/option-a/ravenxcope-a5-back-a-v20.pcraft

# Visual references and superseded full-size proof exports, not build inputs.
/reference/*.png
